{#- An app still in the lab, on the home page: one compact row; the whole row opens the app's page. -#}
{%- set inArabic = lang == "ar" %}
{%- set copy = app.ar if inArabic and app.ar else app %}
<li class="lab-item">
  <img src="/assets/apps/{{ app.slug }}-256.png" alt="" width="56" height="56">
  <div class="title">
    {%- if inArabic %}
    <h4><a href="/{{ app.slug }}/">{{ app.arabicName or app.name }}</a></h4>
    {%- else %}
    <h4><a href="/{{ app.slug }}/">{{ app.name }}</a>{% if app.arabicName %} <span class="ar" lang="ar">{{ app.arabicName }}</span>{% endif %}</h4>
    {%- endif %}
    <p class="subtitle">{{ copy.subtitle }}</p>
  </div>
  <span class="chip soon">{{ t.apps.soon }}</span>
</li>
