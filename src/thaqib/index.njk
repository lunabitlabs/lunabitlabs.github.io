---
title: "Thaqib: Family Good Deeds"
permalink: /thaqib/
# Thaqib's own page, outside the studio layout: the app's night with its
# shooting stars, its star, its colours and its type. Styles in
# assets/thaqib.css, the moving parts in assets/thaqib.js. The same page in
# Arabic is src/ar/thaqib.njk: change both together.
---
{%- set app = apps | appBySlug("thaqib") -%}
{%- set store = "https://apps.apple.com/app/id" + app.appStoreId -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Thaqib: Family Good Deeds</title>
  <meta name="description" content="Thaqib turns good deeds into stars. Kids check in their prayers and good deeds, a grown-up says yes, and stars become rewards your family chooses. For iPhone and iPad, in English and Arabic.">
  <link rel="canonical" href="{{ site.url }}/thaqib/">
  <link rel="alternate" hreflang="en" href="{{ site.url }}/thaqib/">
  <link rel="alternate" hreflang="ar" href="{{ site.url }}/ar/thaqib/">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/thaqib/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Thaqib: good deeds become stars">
  <meta property="og:description" content="Kids check in their prayers and good deeds, a grown-up says yes, and stars become rewards your family chooses.">
  <meta property="og:url" content="{{ site.url }}/thaqib/">
  <meta property="og:image" content="{{ site.url }}/thaqib/img/og.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1A1450">
  <meta name="apple-itunes-app" content="app-id={{ app.appStoreId }}">
  <link rel="icon" href="/assets/apps/thaqib-256.png">
  <link rel="apple-touch-icon" href="/assets/apps/thaqib-256.png">
  <script>
    // This page used to hold the terms and the privacy policy, and the App
    // Store description still links to its sections: send those on.
    (function () {
      function go() {
        var to = { "#terms": "/thaqib/terms/#terms", "#terms-ar": "/thaqib/terms/#terms-ar",
          "#privacy": "/thaqib/privacy/#privacy", "#privacy-ar": "/thaqib/privacy/#privacy-ar" }[location.hash];
        if (to) location.replace(to);
      }
      go();
      window.addEventListener("hashchange", go);
    })();
  </script>
  <link rel="stylesheet" href="/thaqib/assets/thaqib.css?v={{ build.version }}">
  <script defer src="/thaqib/assets/thaqib.js?v={{ build.version }}"></script>
</head>
<body>
  {% include "partials/thaqib-defs.svg" %}
  <div class="glows" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <canvas class="sky" data-sky aria-hidden="true"></canvas>

  <nav class="nav" aria-label="Thaqib">
    <div class="nav-inner">
      <a class="brand" href="/thaqib/"><img src="/assets/apps/thaqib-256.png" alt="" width="36" height="36"><b>Thaqib</b><span lang="ar">ثاقب</span></a>
      <div class="nav-links">
        <a href="#how">How it works</a>
        <a href="#kids">Kids</a>
        <a href="#parents">Parents</a>
        <a href="#family">Family</a>
        <a href="/thaqib/privacy/">Privacy</a>
        <a class="nav-lang" href="/ar/thaqib/" lang="ar" hreflang="ar">العربية</a>
        <a class="gold-button" href="{{ store }}"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star" fill="#4A2A00"/></svg>Download</a>
      </div>
    </div>
  </nav>

  <main>
    <header class="hero wrap">
      <div>
        <span class="pill">iPhone · iPad · English &amp; <span lang="ar">العربية</span></span>
        <h1>Good deeds become <span class="goldtext">stars</span>.</h1>
        <p class="lede">Kids check in their prayers and good deeds, a grown-up says yes, and stars turn into rewards your family chooses.</p>
        <div class="cta">
          <a class="appstore" href="{{ store }}"><img src="/assets/img/app-store-badge.svg" alt="Download Thaqib on the App Store" width="162" height="54"></a>
          <span class="note">Free to download · Start with a free month</span>
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <div class="orbs">
          <img src="/thaqib/img/art/02-orb-shadows-dark.png" alt="" width="640" height="640">
          <img src="/thaqib/img/art/03-orb-yellow.png" alt="" width="640" height="640">
          <img src="/thaqib/img/art/04-orb-coral.png" alt="" width="640" height="640">
          <img src="/thaqib/img/art/05-orb-teal.png" alt="" width="640" height="640">
          <img src="/thaqib/img/art/06-orb-highlights.png" alt="" width="640" height="640" style="opacity: 0.8;">
        </div>
        <div class="star">
          <img src="/thaqib/img/art/07-star-shadow-dark.png" alt="" width="640" height="640">
          <img src="/thaqib/img/art/08-star.png" alt="" width="640" height="640">
          <img src="/thaqib/img/art/09-star-highlight.png" alt="" width="640" height="640" style="opacity: 0.6;">
        </div>
      </div>
    </header>

    <section id="how">
      <div class="wrap">
        <div class="head" data-rise>
          <span class="kicker">How it works</span>
          <h2>Ten points, one star.</h2>
          <p>Every good deed a grown-up approves is a point. Every 10 points make a star.</p>
        </div>
        <div class="steps">
          <div class="step" data-rise>
            <div class="num">1</div>
            <h3>Tap what you did</h3>
            <p>Kids check in the good they do: their five daily prayers, reading Quran, kind words, helping at home, homework.</p>
          </div>
          <div class="step" data-rise>
            <div class="num">2</div>
            <h3>A grown-up says yes</h3>
            <p>Approve check-ins one by one or all at once, with a few seconds to undo.</p>
          </div>
          <div class="step" data-rise>
            <div class="num">3</div>
            <h3>Stars become rewards</h3>
            <p>Stars turn into rewards your family chooses, from extra screen time to a day out.</p>
          </div>
          <div class="star-card" data-star-demo data-rise>
            <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"></svg>
            <div class="words" aria-live="off">
              <small>My next star</small>
              <strong data-star-count>6 of 10</strong>
              <span data-star-label>4 more dots to finish!</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="kids">
      <div class="wrap">
        <div class="row">
          <div class="copy" data-rise>
            <span class="kicker">Kids mode</span>
            <h2>A page of their own.</h2>
            <p>The five prayers, good deeds by category, and a star that fills as points come in.</p>
            <ul class="ticks">
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Tap what you did to check it in; it counts once a grown-up says yes</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Spend stars on rewards, or save up for a goal</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>In English and Arabic, on iPhone and iPad</li>
            </ul>
            <ul class="chips" aria-label="Kinds of good deeds">
              <li style="background: #E0E4FF; color: #3B4BB8;">Prayers</li>
              <li style="background: #D7F5EE; color: #0E7A66;">Quran</li>
              <li style="background: #E7E2FF; color: #5A4BD1;">Character &amp; manners</li>
              <li style="background: #DDF2FF; color: #1E5BB8;">Daily habits</li>
              <li style="background: #FFF0C8; color: #8A4B00;">Chores</li>
              <li style="background: #FFE1EC; color: #B0306C;">School</li>
            </ul>
          </div>
          <div class="phone-wrap" data-rise>
            <div class="phone"><img src="/thaqib/img/kid.jpg" alt="Aaliya's page in Thaqib: her next star at 6 of 10, the five prayers, and “I did something good!”" width="598" height="1300" loading="lazy"></div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head" data-rise>
          <span class="kicker">Prayers</span>
          <h2>The five daily prayers.</h2>
          <p>Each with its own sky, from Fajr to Isha.</p>
        </div>
        <div class="prayers" data-rise>
          <div class="prayer" style="background: linear-gradient(180deg, #3B3191, #E58FB5);"><svg aria-hidden="true"><use href="/thaqib/img/glyphs.svg#g-fajr"/></svg><b>Fajr</b><span lang="ar">الفجر</span></div>
          <div class="prayer" style="background: linear-gradient(180deg, #3D93E0, #8FCBFF);"><svg aria-hidden="true"><use href="/thaqib/img/glyphs.svg#g-dhuhr"/></svg><b>Dhuhr</b><span lang="ar">الظهر</span></div>
          <div class="prayer" style="background: linear-gradient(180deg, #E08A1E, #FFC970);"><svg aria-hidden="true"><use href="/thaqib/img/glyphs.svg#g-asr"/></svg><b>Asr</b><span lang="ar">العصر</span></div>
          <div class="prayer" style="background: linear-gradient(180deg, #D84874, #FF9A62);"><svg aria-hidden="true"><use href="/thaqib/img/glyphs.svg#g-maghrib"/></svg><b>Maghrib</b><span lang="ar">المغرب</span></div>
          <div class="prayer" style="background: linear-gradient(180deg, #1F185C, #4B3CC4);"><svg aria-hidden="true"><use href="/thaqib/img/glyphs.svg#g-isha"/></svg><b>Isha</b><span lang="ar">العشاء</span></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="row row--rev">
          <div class="copy" data-rise>
            <span class="kicker">Their sky</span>
            <h2>Every star, in a sky of their own.</h2>
            <p>Each kid's sky holds every star they have earned, and the deeds that made it.</p>
            <ul class="ticks">
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Tap any star to see how it was earned</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>The stars to spend, always in view</li>
            </ul>
          </div>
          <div class="phone-wrap" data-rise>
            <div class="phone"><img src="/thaqib/img/sky.jpg" alt="Aaliya's sky in Thaqib: seven stars earned since October, joined by dotted lines, and “Star number 7!”" width="598" height="1300" loading="lazy"></div>
          </div>
        </div>
        <div class="row">
          <div class="copy" data-rise>
            <span class="kicker">Rewards</span>
            <h2>Stars become rewards.</h2>
            <p>Rewards your family chooses, from extra screen time to a day out. Spend stars now, or save up for something bigger.</p>
            <ul class="ticks">
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>14 rewards ready to go, or add your own</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Kids ask, and a grown-up says yes</li>
            </ul>
          </div>
          <div class="phone-wrap" data-rise>
            <div class="phone"><img src="/thaqib/img/spend.jpg" alt="Spend my stars in Thaqib: the goal “Pick the movie”, and rewards to save up for" width="598" height="1300" loading="lazy"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="parents">
      <div class="wrap">
        <div class="row row--rev">
          <div class="copy" data-rise>
            <span class="kicker">Parent mode</span>
            <h2>Everything waiting, in one place.</h2>
            <p>Today shows every check-in and request waiting for you.</p>
            <ul class="ticks">
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Approve one by one or all at once, with a few seconds to undo</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Choose what each kid sees: whole categories, or deed by deed</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>44 good deeds and 14 rewards ready to go, or add your own</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Give points or a reward yourself, or take points away for an oops</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>One notification per kid when something is waiting</li>
              <li><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#star"/></svg>Locked with a family PIN, and Face ID or Touch ID on your own device</li>
            </ul>
          </div>
          <div class="pair" data-rise>
            <div class="phone back"><img src="/thaqib/img/sees.jpg" alt="Choosing what a kid sees in Thaqib" width="598" height="1300" loading="lazy"></div>
            <div class="phone front"><img src="/thaqib/img/today.jpg" alt="Thaqib's Today for grown-ups: each kid's stars and what's waiting for you" width="598" height="1300" loading="lazy"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="family">
      <div class="wrap family">
        <div data-rise>
          <span class="kicker">The whole family</span>
          <h2>Together, in sync.</h2>
          <div class="counts">
            <div class="count"><b>4</b><span>grown-ups</span></div>
            <div class="count"><b>6</b><span>kids</span></div>
          </div>
          <ul class="bubbles" aria-hidden="true">
            <li style="background: #6C5CE7;">A</li><li style="background: #7FC4FF;">Y</li><li style="background: #FF8CC6;">M</li>
            <li style="background: #6EE7B7;">S</li><li style="background: #FFC83D;">H</li><li style="background: #FF9E6B;">R</li>
          </ul>
          <p style="color: var(--text-2); font-size: 1.1rem; margin: 0;">Give a kid their own iPhone or iPad that opens straight to their page, or share one family iPad. Everything syncs through iCloud.</p>
        </div>
        <div class="ipad" data-rise><img src="/thaqib/img/ipad-kid.jpg" alt="A kid's page in Thaqib on iPad" width="1125" height="1500" loading="lazy"></div>
      </div>
    </section>

    <section id="private">
      <div class="wrap">
        <div class="head" data-rise>
          <span class="kicker">Private by design</span>
          <h2>Your family's, and no one else's.</h2>
          <p>Your family's information stays on your devices and in your own iCloud, shared only with the people you invite. We can't see it.</p>
        </div>
        <div class="cards" data-rise>
          <div class="card"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 5l18 14"/></svg><b>No ads</b><p>Nothing to sell to your kids.</p></div>
          <div class="card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M3 3l18 18"/></svg><b>No analytics</b><p>We don't measure your family.</p></div>
          <div class="card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12zM3 3l18 18"/></svg><b>No tracking</b><p>Not across apps, not across the web.</p></div>
          <div class="card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg><b>No new accounts</b><p>Your Apple Account and iCloud are enough.</p></div>
        </div>
        <p style="text-align: center; margin: 22px 0 0;"><a href="/thaqib/privacy/" style="color: var(--gold); font-weight: 800;">Read the privacy policy</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="plan" data-rise>
          <div>
            <span class="kicker">Thaqib Family</span>
            <h2>Free to download. A month on us.</h2>
            <p>The Thaqib Family subscription unlocks everything for the whole family, on all your devices. New subscribers start with one month free; after that it is a yearly subscription at the price shown in the app.</p>
            <p>Families who bought Thaqib before it became a subscription keep everything, free, for good.</p>
            <p style="margin: 0;"><a href="/thaqib/terms/">Terms of Service</a> · <a href="/thaqib/privacy/">Privacy Policy</a></p>
          </div>
          <img class="badge-star" src="/thaqib/img/art/08-star.png" alt="" width="640" height="640" loading="lazy">
        </div>
      </div>
    </section>

    <section class="final" id="support">
      <div class="wrap">
        <div class="welcome-star" aria-hidden="true">
          <i></i><i></i>
          <svg viewBox="0 0 100 100"><use href="#star" fill="url(#iconGold)" stroke="rgba(240, 122, 18, 0.35)" stroke-width="1.45"/><ellipse cx="40" cy="40" rx="15" ry="7.6" fill="url(#glint)" transform="rotate(-30 40 40)"/></svg>
        </div>
        <h2>Thaqib turns good deeds into stars.</h2>
        <p>For iPhone and iPad, in English and Arabic.</p>
        <a class="appstore" href="{{ store }}" style="display: inline-block;"><img src="/assets/img/app-store-badge.svg" alt="Download Thaqib on the App Store" width="168" height="56" style="height: 56px;"></a>
        <p style="margin: 40px auto 0; font-size: 1rem;">Questions or feedback? Write to <a href="mailto:{{ site.email }}" style="color: var(--gold); font-weight: 800;">{{ site.email }}</a>. To manage or cancel the subscription, open the Settings app, tap your name, then Subscriptions; in Thaqib, it's in Settings › Subscription › Manage in the App Store.</p>
      </div>
    </section>
  </main>

  <footer>
    <div class="foot">
      <div class="who"><img src="/assets/apps/thaqib-256.png" alt="" width="28" height="28"><span>© {{ build.year }} <a href="/">Lunabit Labs</a></span></div>
      <nav aria-label="Thaqib links">
        <a href="/thaqib/terms/">Terms of Service</a>
        <a href="/thaqib/privacy/">Privacy Policy</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="{{ store }}">App Store</a>
        <a href="/apps/">More apps</a>
      </nav>
    </div>
  </footer>
</body>
</html>
