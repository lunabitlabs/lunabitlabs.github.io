---
title: "لقاء الاثنين"
permalink: /monday/
noindex: true
eleventyExcludeFromCollections: true
# A one-off page for friends: pick a place and a time for Monday's gathering.
# A whole HTML document with its styles and script inline, outside the studio
# layout. Nothing on the site links to it, and it is left out of the sitemap.
---
{% raw %}<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>لقاء الاثنين</title>
<meta name="robots" content="noindex">
<meta property="og:title" content="لقاء الاثنين">
<meta property="og:description" content="اختر مكان ووقت لقاء الليلة.">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lalezar&family=Readex+Pro:wght@400;500;600;700&display=swap">
<style>
/* What the page was first written against: no body margin, hidden means hidden,
   and room for the phone's status bar and home indicator. */
:root { padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px); }
body { margin: 0; }
[hidden] { display: none !important; }
/* Layout: one narrow column of screens that swap over a Gulf evening sky
   (sunset by day, full-moon night in dark). Chunky, pressable controls. */
:root {
  --sky-1: #FFE9BD;
  --sky-2: #FFB790;
  --sky-3: #F48FA6;
  --ink: #3B1650;
  --ink-soft: #6B4680;
  --card: #FFFBF4;
  --card-line: #EFD3BF;
  --field: #FFF3E3;
  --accent: #D81E5B;
  --accent-deep: #A01243;
  --accent-ink: #FFFFFF;
  --ok: #0C857D;
  --ok-ink: #FFFFFF;
  --orb: #FFC527;
  --orb-halo: rgba(255, 197, 39, .28);
  --orb-crater: transparent;
  --star: rgba(255, 255, 255, .95);
  --cloud: rgba(255, 255, 255, .55);
  --skyline: rgba(59, 22, 80, .17);
  --note: #FFE45C;
  --note-ink: #3B1650;
  --tape: rgba(255, 255, 255, .7);
  --scrim: rgba(59, 22, 80, .5);
  --shadow: rgba(59, 22, 80, .2);

  --font-display: "Lalezar", "Tahoma", "Arial", sans-serif;
  --font-body: "Readex Pro", "Segoe UI", Tahoma, Arial, sans-serif;
  --spring: cubic-bezier(.2, 1.5, .4, 1);
  --r: 20px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --sky-1: #130A31; --sky-2: #2B1357; --sky-3: #5A1F60;
    --ink: #FFF1DC; --ink-soft: #CFBBE8;
    --card: #271652; --card-line: #452C80; --field: #1C0F40;
    --accent: #FF5A8F; --accent-deep: #B92B5E; --accent-ink: #2A0718;
    --ok: #3DDBC8; --ok-ink: #062B27;
    --orb: #FFE9A8; --orb-halo: rgba(255, 233, 168, .16); --orb-crater: rgba(196, 160, 84, .45);
    --star: #FFF6D6; --cloud: rgba(255, 255, 255, .06);
    --skyline: rgba(8, 3, 26, .62);
    --note: #FFE45C; --note-ink: #3B1650; --tape: rgba(255, 255, 255, .55);
    --scrim: rgba(6, 2, 20, .68); --shadow: rgba(0, 0, 0, .45);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --sky-1: #130A31; --sky-2: #2B1357; --sky-3: #5A1F60;
  --ink: #FFF1DC; --ink-soft: #CFBBE8;
  --card: #271652; --card-line: #452C80; --field: #1C0F40;
  --accent: #FF5A8F; --accent-deep: #B92B5E; --accent-ink: #2A0718;
  --ok: #3DDBC8; --ok-ink: #062B27;
  --orb: #FFE9A8; --orb-halo: rgba(255, 233, 168, .16); --orb-crater: rgba(196, 160, 84, .45);
  --star: #FFF6D6; --cloud: rgba(255, 255, 255, .06);
  --skyline: rgba(8, 3, 26, .62);
  --note: #FFE45C; --note-ink: #3B1650; --tape: rgba(255, 255, 255, .55);
  --scrim: rgba(6, 2, 20, .68); --shadow: rgba(0, 0, 0, .45);
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
html, body { height: 100%; }
body {
  background: var(--sky-2);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 17px;
  line-height: 1.6;
  -webkit-tap-highlight-color: transparent;
}
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--ok); outline-offset: 3px; }

/* ---------- sky ---------- */
.sky {
  position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
  background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 58%, var(--sky-3) 100%);
}
.orb {
  position: absolute; bottom: calc(env(safe-area-inset-bottom, 0px) + 118px); left: 11%;
  width: 72px; aspect-ratio: 1; border-radius: 50%;
  background: var(--orb);
  box-shadow: 0 0 0 14px var(--orb-halo), 0 0 0 30px var(--orb-halo);
  animation: bob 6s ease-in-out infinite;
}
.orb::before, .orb::after {
  content: ""; position: absolute; border-radius: 50%; background: var(--orb-crater);
}
.orb::before { width: 22%; aspect-ratio: 1; top: 24%; left: 22%; }
.orb::after { width: 14%; aspect-ratio: 1; top: 58%; left: 56%; box-shadow: -18px 8px 0 2px var(--orb-crater); }
.star {
  position: absolute; width: var(--s); height: var(--s); border-radius: 50%;
  background: var(--star);
  animation: twinkle var(--t) ease-in-out var(--dl) infinite;
}
.skyline { position: absolute; inset: auto 0 0 0; width: 100%; height: 96px; fill: var(--skyline); }

/* ---------- shell ---------- */
.app {
  position: relative; z-index: 1;
  min-height: 100%;
  max-width: 460px; margin-inline: auto;
  padding-block: 18px 28px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  display: flex; flex-direction: column; gap: 18px;
  overflow-x: clip;
}
.top { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 32px; }
.brand {
  font-family: var(--font-display); font-size: 24px; line-height: 1.2;
  opacity: 0; transform: translateY(-8px); transition: opacity .3s, transform .4s var(--spring);
}
.app[data-step="0"] .brand { visibility: hidden; }
.app:not([data-step="0"]) .brand { opacity: 1; transform: none; }
.steps { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
.steps li {
  width: 10px; height: 10px; border-radius: 10px;
  background: var(--card); opacity: .45;
  transition: width .45s var(--spring), opacity .3s, background .3s;
}
.steps li.on { opacity: 1; background: var(--accent); }
.steps li.now { width: 30px; }

.screen { display: flex; flex-direction: column; gap: 16px; }
.screen > * { animation: rise .6s var(--spring) backwards; }
.screen > *:nth-child(2) { animation-delay: 90ms; }
.screen > *:nth-child(3) { animation-delay: 180ms; }
.screen > *:nth-child(4) { animation-delay: 270ms; }
.screen > *:nth-child(5) { animation-delay: 360ms; }
.screen.out { animation: leave .24s ease-in forwards; }
.screen.out > * { animation: none; }

/* ---------- type ---------- */
.hero {
  font-family: var(--font-display); font-weight: 400;
  font-size: clamp(64px, 21vw, 104px); line-height: 1.12;
  margin: 12vh 0 0; text-align: center; text-wrap: balance;
}
.hero span { display: inline-block; animation: drop .9s var(--spring) backwards, sway 5s ease-in-out 1.2s infinite; }
.hero span:nth-child(2) { color: var(--accent); animation-delay: .18s, 1.6s; }
.squiggle { display: block; width: 190px; max-width: 60%; margin: -8px auto 0; overflow: visible; }
.squiggle path {
  fill: none; stroke: var(--ink); stroke-width: 5; stroke-linecap: round;
  stroke-dasharray: 260; stroke-dashoffset: 260; animation: draw 1s ease-out .7s forwards;
}
.lede { margin: 0; text-align: center; font-size: 18px; font-weight: 500; }
.hello { margin: 6px 0 -10px; font-size: 18px; font-weight: 500; }
.hello b { color: var(--accent); font-weight: 700; }
.wave { display: inline-block; transform-origin: 70% 80%; animation: wave 1.6s ease-in-out .5s 2; }
.q { font-family: var(--font-display); font-weight: 400; font-size: clamp(32px, 9.5vw, 42px); line-height: 1.25; margin: 0; text-wrap: balance; }

/* ---------- name card ---------- */
.card {
  background: var(--card); border: 2px solid var(--card-line); border-radius: 26px;
  padding: 20px; display: flex; flex-direction: column; gap: 12px;
  box-shadow: 0 14px 30px -12px var(--shadow);
}
.card label { font-weight: 600; font-size: 18px; }
.card input {
  width: 100%; min-width: 0; font-size: 19px; padding: 14px 16px;
  background: var(--field); border: 2px solid var(--card-line); border-radius: 16px;
  transition: border-color .2s, transform .3s var(--spring);
}
.card input::placeholder { color: var(--ink-soft); opacity: .8; }
.card input:focus { outline: none; border-color: var(--accent); transform: scale(1.015); }
.err { margin: 0; color: var(--accent); font-weight: 600; font-size: 15px; }
.card.shake { animation: shake .45s; }

.btn {
  appearance: none; border: 0; cursor: pointer;
  min-height: 56px; padding: 10px 22px; border-radius: 18px;
  background: var(--accent); color: var(--accent-ink);
  font-family: var(--font-display); font-size: 26px; line-height: 1.2;
  box-shadow: 0 6px 0 var(--accent-deep);
  transition: transform .12s, box-shadow .12s;
}
.btn:active { transform: translateY(5px); box-shadow: 0 1px 0 var(--accent-deep); }
.link {
  appearance: none; cursor: pointer; align-self: center;
  background: var(--card); border: 2px solid var(--card-line); border-radius: 30px;
  padding: 8px 18px; font-weight: 600; font-size: 15px; color: var(--ink);
}

/* ---------- place options ---------- */
.opts { display: flex; flex-direction: column; gap: 9px; }
.opt {
  appearance: none; cursor: pointer; text-align: start;
  display: flex; align-items: center; gap: 12px;
  min-height: 52px; padding: 8px 14px;
  background: var(--card); border: 2px solid var(--card-line); border-radius: 18px;
  font-weight: 600; font-size: 17px;
  box-shadow: 0 4px 0 var(--card-line);
  transition: transform .12s, box-shadow .12s, border-color .2s, opacity .3s;
  animation: flow .55s var(--spring) backwards;
  animation-delay: calc(var(--i) * 70ms + 260ms);
}
.opt:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--card-line); }
.opt .name { flex: 1; min-width: 0; }
.dot {
  flex: none; width: 26px; height: 26px; border-radius: 50%;
  border: 2.5px solid var(--ink-soft); display: grid; place-items: center;
  transition: background .2s, border-color .2s;
}
.dot svg { width: 14px; height: 14px; stroke: var(--accent-ink); stroke-width: 3.5; fill: none; stroke-linecap: round; stroke-linejoin: round; transform: scale(0); transition: transform .35s var(--spring); }
.opt[aria-checked="true"] { border-color: var(--accent); box-shadow: 0 4px 0 var(--accent); }
.opt[aria-checked="true"] .dot { background: var(--accent); border-color: var(--accent); }
.opt[aria-checked="true"] .dot svg { transform: scale(1); }
.opt.ok { border-color: var(--ok); box-shadow: 0 4px 0 var(--ok); animation: pop .6s var(--spring); }
.opt.ok .dot { background: var(--ok); border-color: var(--ok); }
.opt.ok .dot svg { stroke: var(--ok-ink); }
.tag { flex: none; font-size: 12.5px; font-weight: 700; padding: 3px 10px; border-radius: 20px; background: var(--field); border: 1.5px solid var(--card-line); }
.opt.off { cursor: not-allowed; opacity: .55; box-shadow: none; animation: wobble .5s; }
.opt.off .name { text-decoration: line-through; text-decoration-thickness: 2px; }

/* ---------- times ---------- */
.chip {
  align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; margin: 6px 0 -6px;
  padding: 7px 14px; border-radius: 30px; font-weight: 600; font-size: 15.5px;
  background: var(--card); border: 2px solid var(--ok);
}
.chip svg { width: 16px; height: 16px; fill: var(--ok); flex: none; }
.times { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.time {
  appearance: none; cursor: pointer;
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  padding: 20px 6px 14px;
  background: var(--card); border: 2px solid var(--card-line); border-radius: 24px;
  box-shadow: 0 6px 0 var(--card-line);
  font-family: var(--font-display); font-size: 27px; line-height: 1.2;
  transition: transform .12s, box-shadow .12s, border-color .2s;
  animation: flow .6s var(--spring) backwards;
  animation-delay: calc(var(--i) * 120ms + 260ms);
}
.time small { display: block; font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--ink-soft); }
.time:active { transform: translateY(5px); box-shadow: 0 1px 0 var(--card-line); }
.time.ok { border-color: var(--ok); box-shadow: 0 6px 0 var(--ok); animation: pop .6s var(--spring); }
.clock {
  position: relative; width: 62px; aspect-ratio: 1; border-radius: 50%;
  background: var(--field); border: 4px solid var(--ink);
}
.clock i { position: absolute; left: 50%; bottom: 50%; width: 4px; margin-left: -2px; border-radius: 4px; transform-origin: 50% 100%; }
.clock .h { height: 27%; background: var(--ink); transform: rotate(var(--a)); animation: sweep 1.1s var(--spring) backwards; animation-delay: calc(var(--i) * 120ms + 500ms); }
.clock .m { height: 38%; background: var(--accent); }
.clock::after { content: ""; position: absolute; inset: 0; margin: auto; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); }

/* ---------- done ---------- */
.ticket-wrap { filter: drop-shadow(0 14px 18px var(--shadow)); }
.ticket {
  background: var(--card); border-radius: 24px; overflow: hidden;
  -webkit-mask: radial-gradient(circle 11px at 0 60px, #0000 97%, #000) , radial-gradient(circle 11px at 100% 60px, #0000 97%, #000);
  -webkit-mask-composite: source-in;
  mask: radial-gradient(circle 11px at 0 60px, #0000 97%, #000) intersect, radial-gradient(circle 11px at 100% 60px, #0000 97%, #000);
}
.t-head {
  height: 60px; display: grid; place-items: center;
  background: var(--accent); color: var(--accent-ink);
  font-family: var(--font-display); font-size: 26px; line-height: 1;
}
.t-body { margin: 0; padding: 18px 26px 6px; display: flex; flex-direction: column; gap: 12px; }
.t-body div { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
.t-body dt { font-size: 15px; font-weight: 600; color: var(--ink-soft); flex: none; }
.t-body dd { margin: 0; font-family: var(--font-display); font-size: 27px; line-height: 1.25; text-align: end; min-width: 0; }
.t-msg {
  margin: 12px 20px 20px; padding: 12px 10px; text-align: center;
  border: 2.5px dashed var(--accent); border-radius: 16px;
  color: var(--accent); font-weight: 700; font-size: 18px;
  animation: stamp .6s var(--spring) .9s backwards;
}
.note {
  position: relative; align-self: center; width: min(100%, 340px); margin-top: 10px;
  padding: 26px 20px 20px; text-align: center;
  background: var(--note); color: var(--note-ink);
  border-radius: 4px 4px 22px 4px;
  box-shadow: 0 16px 22px -10px var(--shadow);
  transform: rotate(-3deg);
  animation: fly 1s var(--spring) backwards !important;
}
.note::before {
  content: ""; position: absolute; top: -12px; left: 50%; width: 92px; height: 26px; margin-left: -46px;
  background: var(--tape); transform: rotate(2deg);
}
.note strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: 34px; line-height: 1.25; }
.note p { margin: 6px 0 0; font-weight: 600; font-size: 17.5px; line-height: 1.7; }

/* ---------- dialog ---------- */
.overlay {
  position: fixed; inset: 0; z-index: 20; display: grid; place-items: center;
  padding: 20px max(20px, env(safe-area-inset-right, 0px)) 20px max(20px, env(safe-area-inset-left, 0px));
  background: var(--scrim); animation: fade .2s both;
}
.dialog {
  width: min(100%, 350px); padding: 8px 22px 22px; text-align: center;
  background: var(--card); border: 2px solid var(--card-line); border-radius: 28px;
  box-shadow: 0 24px 50px -10px var(--shadow);
  display: flex; flex-direction: column; gap: 10px;
  animation: pop-in .5s var(--spring) both;
}
.sign { align-self: center; width: 150px; height: 104px; position: relative; transform-origin: 50% 0; animation: swing 1.8s ease-in-out infinite; }
.sign::before {
  content: ""; position: absolute; top: 4px; left: 50%; width: 76px; height: 76px; margin-left: -38px;
  border: 3px solid var(--ink-soft); border-bottom: 0; border-right: 0; transform: rotate(45deg); transform-origin: 50% 50%;
  top: 14px;
}
.sign::after {
  content: ""; position: absolute; top: 6px; left: 50%; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; background: var(--ink);
}
.sign b {
  position: absolute; inset: auto 0 0 0; height: 54px; display: grid; place-items: center;
  background: var(--accent); color: var(--accent-ink); border-radius: 12px;
  font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1;
}
.dialog h2 { font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1.3; margin: 4px 0 0; text-wrap: balance; }
.dialog p { margin: 0 0 6px; color: var(--ink-soft); font-weight: 500; }

#confetti { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 30; pointer-events: none; }

/* ---------- motion ---------- */
@keyframes rise { from { opacity: 0; transform: translateY(26px) scale(.96); } }
@keyframes flow { from { opacity: 0; transform: translateX(-46px) rotate(-2deg); } }
@keyframes leave { to { opacity: 0; transform: translateY(-16px) scale(.97); } }
@keyframes drop { from { opacity: 0; transform: translateY(-70px) rotate(-10deg) scale(.7); } }
@keyframes sway { 0%, 100% { transform: rotate(-1.6deg); } 50% { transform: rotate(1.6deg) translateY(-3px); } }
@keyframes draw { to { stroke-dashoffset: 0; } }
@keyframes wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(18deg); } 50% { transform: rotate(-10deg); } 75% { transform: rotate(14deg); } }
@keyframes shake { 20% { transform: translateX(9px); } 40% { transform: translateX(-9px); } 60% { transform: translateX(6px); } 80% { transform: translateX(-4px); } }
@keyframes wobble { 25% { transform: rotate(-1.5deg) translateX(5px); } 60% { transform: rotate(1.2deg) translateX(-4px); } }
@keyframes pop { 40% { transform: scale(1.06); } }
@keyframes pop-in { from { opacity: 0; transform: scale(.6) rotate(-6deg); } }
@keyframes fade { from { opacity: 0; } }
@keyframes swing { 0%, 100% { transform: rotate(-7deg); } 50% { transform: rotate(7deg); } }
@keyframes sweep { from { transform: rotate(0deg); } }
@keyframes stamp { from { opacity: 0; transform: scale(1.5) rotate(-6deg); } }
@keyframes fly { from { opacity: 0; transform: translate(-115%, -50px) rotate(-28deg); } }
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
@keyframes twinkle { 0%, 100% { opacity: .2; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.15); } }
@keyframes drift { from { transform: translateX(-140px); } to { transform: translateX(100vw); } }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .squiggle path { stroke-dashoffset: 0; }
}
</style>
</head>
<body>
<div class="sky" aria-hidden="true">
  <div class="orb"></div>
  <div id="stars"></div>
  <svg class="skyline" viewBox="0 0 400 96" preserveAspectRatio="xMidYMax slice">
    <rect x="0" y="62" width="34" height="34"/><rect x="38" y="44" width="20" height="52"/>
    <rect x="62" y="70" width="30" height="26"/>
    <circle cx="112" cy="70" r="14"/><rect x="98" y="70" width="28" height="26"/><rect x="130" y="34" width="6" height="62"/><circle cx="133" cy="32" r="4"/>
    <polygon points="152,96 170,10 178,96"/><polygon points="184,96 192,10 210,96"/><rect x="176" y="40" width="10" height="3"/><rect x="175" y="60" width="12" height="3"/>
    <rect x="218" y="56" width="26" height="40"/><rect x="250" y="24" width="18" height="72"/><rect x="254" y="14" width="10" height="12"/>
    <rect x="274" y="66" width="36" height="30"/><rect x="316" y="48" width="22" height="48"/><rect x="344" y="72" width="26" height="24"/><rect x="374" y="54" width="26" height="42"/>
  </svg>
</div>
<canvas id="confetti" aria-hidden="true"></canvas>

<main class="app" id="app" dir="rtl" lang="ar" data-step="0">
  <header class="top">
    <div class="brand" aria-hidden="true">لقاء الاثنين</div>
    <ol class="steps" id="steps" aria-label="مراحل الاختيار">
      <li class="on now"></li><li></li><li></li><li></li>
    </ol>
  </header>

  <!-- 1 · name -->
  <section class="screen" id="s-name">
    <h1 class="hero"><span>لقاء</span> <span>الاثنين</span></h1>
    <svg class="squiggle" viewBox="0 0 210 24" aria-hidden="true"><path d="M6 12 Q 30 0 54 12 T 102 12 T 150 12 T 204 12"/></svg>
    <p class="lede">الليلة موعدنا. اكتب اسمك لنبدأ.</p>
    <form class="card" id="f-name" novalidate>
      <label for="name">ما اسمك؟</label>
      <input id="name" name="name" type="text" maxlength="24" autocomplete="given-name" enterkeyhint="go" placeholder="اكتب اسمك هنا" aria-describedby="name-err">
      <p class="err" id="name-err" role="alert" hidden>اكتب اسمك أولاً لنعرف من معنا.</p>
      <button class="btn" type="submit">هيّا بنا</button>
    </form>
  </section>

  <!-- 2 · place -->
  <section class="screen" id="s-place" hidden>
    <p class="hello">أهلاً يا <b id="hello-name"></b> <span class="wave" aria-hidden="true">👋</span></p>
    <h2 class="q" id="q-place" tabindex="-1">أين تريد أن نلتقي الليلة؟</h2>
    <div class="opts" id="places" role="radiogroup" aria-labelledby="q-place"></div>
  </section>

  <!-- 3 · time -->
  <section class="screen" id="s-time" hidden>
    <p class="chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><span id="chip-place"></span></p>
    <h2 class="q" id="q-time" tabindex="-1">في أي ساعة نلتقي؟</h2>
    <div class="times" id="times" role="radiogroup" aria-labelledby="q-time"></div>
  </section>

  <!-- 4 · done -->
  <section class="screen" id="s-done" hidden>
    <h2 class="q" id="q-done" tabindex="-1">رائع يا <span id="done-name"></span>!</h2>
    <div class="ticket-wrap">
      <div class="ticket">
        <div class="t-head">موعدنا الليلة</div>
        <dl class="t-body">
          <div><dt>المكان</dt><dd id="d-place"></dd></div>
          <div><dt>الوقت</dt><dd id="d-time"></dd></div>
        </dl>
        <p class="t-msg">نرجو الحضور في الوقت المحدد</p>
      </div>
    </div>
    <div role="status">
      <aside class="note" id="note" hidden>
        <strong>هذا مجرد اختبار!</strong>
        <p>الآن ارجع إلى المجموعة وانتظر رسالة صلاح، وردّ هناك.</p>
      </aside>
    </div>
    <button class="link" id="restart" type="button" hidden>البدء من جديد</button>
  </section>
</main>

<div class="overlay" id="overlay" hidden>
  <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dlg-title" aria-describedby="dlg-sub" dir="rtl" lang="ar">
    <div class="sign" aria-hidden="true"><b>مغلق</b></div>
    <h2 id="dlg-title">هذا الخيار غير متاح اليوم</h2>
    <p id="dlg-sub"></p>
    <button class="btn" id="dlg-ok" type="button">اختر مكاناً آخر</button>
  </div>
</div>

<script>
(function () {
  var root = document.documentElement;
  root.lang = 'ar'; root.dir = 'rtl';

  var PLACES = [
    'مجمع سيتي سنتر', 'مجمع الأفنيوز', 'مراسي غاليريا', 'مجمع السيف', 'مجمع ديستركت ون',
    'الليوان', 'سند', 'كورتيارد السيف', 'سوق المنامة'
  ];
  var TIMES = [
    { num: '٧', label: '٧ مساءً', angle: 210 },
    { num: '٨', label: '٨ مساءً', angle: 240 },
    { num: '٩', label: '٩ مساءً', angle: 270 }
  ];
  var ORDER = ['s-name', 's-place', 's-time', 's-done'];
  var CHECK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>';

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var $ = function (id) { return document.getElementById(id); };
  var app = $('app'), overlay = $('overlay');
  var state = { name: '', attempts: 0, place: '', time: '', busy: false, pending: null };
  var noteTimer = 0;

  /* ----- sky ----- */
  (function stars() {
    var box = $('stars'), html = '';
    for (var i = 0; i < 34; i++) {
      html += '<i class="star" style="left:' + (Math.random() * 100).toFixed(1) + '%;top:' + (Math.random() * 62).toFixed(1) +
        '%;--s:' + (2 + Math.random() * 3).toFixed(1) + 'px;--t:' + (2 + Math.random() * 3).toFixed(1) + 's;--dl:-' + (Math.random() * 4).toFixed(1) + 's"></i>';
    }
    box.innerHTML = html;
  })();

  /* ----- confetti ----- */
  var cv = $('confetti'), ctx = cv.getContext('2d'), parts = [], raf = 0, dpr = 1;
  function fit() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(window.innerWidth * dpr); cv.height = Math.round(window.innerHeight * dpr);
  }
  fit(); window.addEventListener('resize', fit);
  function palette() {
    var cs = getComputedStyle(root);
    return ['--accent', '--ok', '--orb', '--note', '--card'].map(function (t) { return cs.getPropertyValue(t).trim() || '#fff'; });
  }
  function burst(x, y, n, power) {
    if (reduce) return;
    var cols = palette();
    for (var i = 0; i < n; i++) {
      var a = Math.random() * Math.PI * 2, v = (0.35 + Math.random()) * power;
      parts.push({
        x: x, y: y, vx: Math.cos(a) * v, vy: Math.sin(a) * v - power * 0.7,
        w: 6 + Math.random() * 7, h: 4 + Math.random() * 5,
        r: Math.random() * 6, vr: (Math.random() - 0.5) * 0.5,
        c: cols[i % cols.length], life: 0, max: 80 + Math.random() * 50, round: Math.random() < 0.3
      });
    }
    if (!raf) raf = requestAnimationFrame(tick);
  }
  function burstFrom(el, n, power) {
    var r = el.getBoundingClientRect();
    burst(r.left + r.width / 2, r.top + r.height / 2, n, power);
  }
  function tick() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    parts = parts.filter(function (p) { return p.life < p.max && p.y < window.innerHeight + 40; });
    parts.forEach(function (p) {
      p.life++; p.vy += 0.32; p.vx *= 0.985; p.x += p.vx; p.y += p.vy; p.r += p.vr;
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
      ctx.globalAlpha = Math.min(1, (p.max - p.life) / 22);
      ctx.fillStyle = p.c;
      if (p.round) { ctx.beginPath(); ctx.arc(0, 0, p.h, 0, 6.3); ctx.fill(); }
      else ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h * Math.abs(Math.cos(p.life / 7)) + 1);
      ctx.restore();
    });
    raf = parts.length ? requestAnimationFrame(tick) : 0;
  }

  /* ----- navigation ----- */
  function go(id) {
    var cur = document.querySelector('.screen:not([hidden])'), next = $(id);
    var idx = ORDER.indexOf(id);
    function swap() {
      if (cur) { cur.hidden = true; cur.classList.remove('out'); }
      next.hidden = false;
      app.dataset.step = idx;
      Array.prototype.forEach.call($('steps').children, function (li, i) {
        li.className = (i <= idx ? 'on' : '') + (i === idx ? ' now' : '');
      });
      window.scrollTo(0, 0);
      var h = next.querySelector('[tabindex="-1"]');
      if (h) h.focus({ preventScroll: true });
      state.busy = false;
    }
    if (!cur || cur === next || reduce) return swap();
    cur.classList.add('out');
    setTimeout(swap, 240);
  }

  /* ----- 1 · name ----- */
  var form = $('f-name'), input = $('name'), err = $('name-err');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var v = input.value.replace(/\s+/g, ' ').trim();
    if (!v) {
      err.hidden = false;
      form.classList.remove('shake'); void form.offsetWidth; form.classList.add('shake');
      input.focus();
      return;
    }
    err.hidden = true;
    state.name = v;
    $('hello-name').textContent = v;
    $('done-name').textContent = v;
    input.blur();
    renderPlaces();
    burstFrom(form.querySelector('.btn'), 26, 7);
    go('s-place');
  });
  input.addEventListener('input', function () { if (input.value.trim()) err.hidden = true; });

  /* ----- 2 · place ----- */
  function renderPlaces() {
    var box = $('places'); box.innerHTML = '';
    state.attempts = 0; state.place = ''; state.pending = null;
    PLACES.forEach(function (p, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'opt'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', 'false');
      b.style.setProperty('--i', i);
      b.innerHTML = '<span class="dot">' + CHECK + '</span><span class="name"></span>';
      b.querySelector('.name').textContent = p;
      b.addEventListener('click', function () { pickPlace(b, p); });
      box.appendChild(b);
    });
  }
  function pickPlace(btn, place) {
    if (state.busy || btn.disabled) return;
    state.busy = true;
    Array.prototype.forEach.call($('places').children, function (o) { o.setAttribute('aria-checked', o === btn ? 'true' : 'false'); });
    state.attempts++;
    if (state.attempts <= 2) {
      state.pending = btn;
      setTimeout(function () { openDialog(place); }, reduce ? 0 : 480);
    } else {
      state.place = place;
      btn.classList.add('ok');
      burstFrom(btn, 60, 10);
      $('chip-place').textContent = place;
      renderTimes();
      setTimeout(function () { go('s-time'); }, reduce ? 0 : 950);
    }
  }

  /* ----- dialog ----- */
  function openDialog(place) {
    $('dlg-sub').textContent = state.attempts === 1
      ? '«' + place + '» خارج القائمة الليلة. جرّب مكاناً آخر.'
      : 'و«' + place + '» أيضاً! جرّب مرة أخرى، فالثالثة ثابتة.';
    overlay.hidden = false;
    $('dlg-ok').focus();
  }
  function closeDialog() {
    if (overlay.hidden) return;
    overlay.hidden = true;
    var btn = state.pending; state.pending = null;
    if (btn) {
      btn.setAttribute('aria-checked', 'false');
      btn.disabled = true; btn.setAttribute('aria-disabled', 'true');
      btn.classList.add('off');
      var tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = 'غير متاح';
      btn.appendChild(tag);
    }
    state.busy = false;
    var nextOpt = document.querySelector('.opt:not(.off)');
    if (nextOpt) nextOpt.focus({ preventScroll: true });
  }
  $('dlg-ok').addEventListener('click', closeDialog);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeDialog(); });
  document.addEventListener('keydown', function (e) {
    if (overlay.hidden) return;
    if (e.key === 'Escape') closeDialog();
    if (e.key === 'Tab') { e.preventDefault(); $('dlg-ok').focus(); }
  });

  /* ----- 3 · time ----- */
  function renderTimes() {
    var box = $('times'); box.innerHTML = '';
    TIMES.forEach(function (t, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'time'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', 'false');
      b.setAttribute('aria-label', t.label);
      b.style.setProperty('--i', i); b.style.setProperty('--a', t.angle + 'deg');
      b.innerHTML = '<span class="clock"><i class="h"></i><i class="m"></i></span><span>' + t.num + '<small>مساءً</small></span>';
      b.addEventListener('click', function () {
        if (state.busy) return;
        state.busy = true; state.time = t.label;
        b.setAttribute('aria-checked', 'true'); b.classList.add('ok');
        burstFrom(b, 50, 10);
        $('d-place').textContent = state.place;
        $('d-time').textContent = t.label;
        setTimeout(showDone, reduce ? 0 : 800);
      });
      box.appendChild(b);
    });
  }

  /* ----- 4 · done ----- */
  function showDone() {
    var note = $('note'), restart = $('restart');
    note.hidden = true; restart.hidden = true;
    go('s-done');
    setTimeout(function () {
      burst(window.innerWidth * 0.25, window.innerHeight * 0.3, 70, 12);
      burst(window.innerWidth * 0.75, window.innerHeight * 0.3, 70, 12);
    }, 450);
    clearTimeout(noteTimer);
    noteTimer = setTimeout(function () {
      note.hidden = false; restart.hidden = false;
      try { restart.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' }); } catch (e) {}
      setTimeout(function () { burstFrom(note, 40, 8); }, 650);
    }, reduce ? 0 : 2200);
  }
  $('restart').addEventListener('click', function () {
    clearTimeout(noteTimer);
    state.busy = false;
    go('s-name');
    setTimeout(function () { input.focus(); input.select(); }, 320);
  });
})();
</script>
</body>
</html>
{% endraw %}
